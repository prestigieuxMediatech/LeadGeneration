// SociAL MEDIA DETAILS 

async function findWebsiteDetails(browser, website) {
  if (!website) {
    return {
      email: null,
      instagram: null,
      facebook: null,
      youtube: null,
    };
  }

  const websitePage = await browser.newPage();

  try {
    await websitePage.goto(website, {
      waitUntil: "domcontentloaded",
      timeout: 20000,
    });

    await new Promise((resolve) =>
      setTimeout(resolve, 2000)
    );

    const details = await websitePage.evaluate(() => {
      const links = [...document.querySelectorAll("a")];

      let instagram = null;
      let facebook = null;
      let youtube = null;

      for (const link of links) {
        const href = link.href?.toLowerCase();

        if (!href) continue;

        if (
          !instagram &&
          href.includes("instagram.com")
        ) {
          instagram = link.href;
        }

        if (
          !facebook &&
          href.includes("facebook.com")
        ) {
          facebook = link.href;
        }

        if (
          !youtube &&
          (
            href.includes("youtube.com") ||
            href.includes("youtu.be")
          )
        ) {
          youtube = link.href;
        }
      }

      /*
      |--------------------------------------------------------------------------
      | Find email
      |--------------------------------------------------------------------------
      */

      const text = document.body.innerText;

      const emails =
        text.match(
          /[A-Z0-9._%+-]+@[A-Z0-9.-]+\.[A-Z]{2,}/gi
        ) || [];

      const email =
        emails.find(
          (email) =>
            !email.includes("example.com") &&
            !email.includes("sentry") &&
            !email.includes("google")
        ) || null;

      return {
        email,
        instagram,
        facebook,
        youtube,
      };
    });

    await websitePage.close();

    return details;

  } catch (error) {

    console.log(
      `Website failed: ${website}`
    );

    await websitePage.close();

    return {
      email: null,
      instagram: null,
      facebook: null,
      youtube: null,
    };
  }
}


