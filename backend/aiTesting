import puppeteer from "puppeteer";

const browser = await puppeteer.launch({
 
  defaultViewport: null,
});

const page = await browser.newPage();

await page.setViewport({
  width: 1080,
  height: 1024,
});

const query = "restaurants in Mumbai";

await page.goto(
  `https://www.google.com/maps/search/${encodeURIComponent(query)}`,
  {
    waitUntil: "domcontentloaded",
  }
);

console.log("Google Maps opened...");

await new Promise((resolve) => setTimeout(resolve, 5000));

/*
|--------------------------------------------------------------------------
| 1. Scroll Google Maps results and collect ALL restaurant links
|--------------------------------------------------------------------------
*/

const restaurantMap = new Map();

let previousCount = 0;
let unchangedCount = 0;

console.log("\nStarting to collect restaurants...\n");

while (unchangedCount < 4) {
  /*
  |--------------------------------------------------------------------------
  | Find all currently loaded restaurant links
  |--------------------------------------------------------------------------
  */

  const restaurantLinks = await page.$$eval(
    '[role="feed"] a[href*="/maps/place/"]',
    (links) => {
      return links.map((link) => ({
        name: link.getAttribute("aria-label"),
        url: link.href,
      }));
    }
  );

  /*
  |--------------------------------------------------------------------------
  | Add restaurants to Map
  |--------------------------------------------------------------------------
  */

  for (const restaurant of restaurantLinks) {
    if (
      restaurant.url &&
      restaurant.url.includes("/maps/place/")
    ) {
      restaurantMap.set(restaurant.url, restaurant);
    }
  }

  console.log(
    `Restaurants collected: ${restaurantMap.size}`
  );

  /*
  |--------------------------------------------------------------------------
  | Scroll Google Maps results panel
  |--------------------------------------------------------------------------
  */

  await page.evaluate(() => {
    const feed = document.querySelector('[role="feed"]');

    if (feed) {
      feed.scrollBy({
        top: 1000,
        behavior: "smooth",
      });
    }
  });

  /*
  |--------------------------------------------------------------------------
  | Wait for Google Maps to load new results
  |--------------------------------------------------------------------------
  */

  await new Promise((resolve) => setTimeout(resolve, 2500));

  /*
  |--------------------------------------------------------------------------
  | Check if new restaurants were found
  |--------------------------------------------------------------------------
  */

  if (restaurantMap.size === previousCount) {
    unchangedCount++;

    console.log(
      `No new restaurants found (${unchangedCount}/4)`
    );
  } else {
    unchangedCount = 0;
  }

  previousCount = restaurantMap.size;
}

const uniqueRestaurants = [...restaurantMap.values()];

console.log("\n==============================");
console.log(
  `TOTAL RESTAURANTS FOUND: ${uniqueRestaurants.length}`
);
console.log("==============================\n");

